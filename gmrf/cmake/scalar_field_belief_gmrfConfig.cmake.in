@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3 3.3 NO_MODULE)

set(scalar_field_belief_gmrf_HAS_TOML @GMRF_HAS_TOML@)
if(scalar_field_belief_gmrf_HAS_TOML)
  # The static TOML loader links toml++ privately; consumers still need it at link time.
  find_dependency(tomlplusplus CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/scalar_field_belief_gmrfTargets.cmake")

# Targets: scalar_field_belief::gmrf, scalar_field_belief::gmrf_toml (if HAS_TOML)
check_required_components(scalar_field_belief_gmrf)
