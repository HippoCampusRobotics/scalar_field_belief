<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scalar_field_belief</name>
  <version>0.0.0</version>
  <description>Simple scalar field belief based on GPytorch</description>

  <maintainer email="nathalie.bauschmann@tuhh.de">Nathalie Bauschmann</maintainer>

  <license>GPL-3.0-only</license>

  <url type="website">hippocampusrobotics.github.io/docs</url>
  <author email="nathalie.bauschmann@tuhh.de">Nathalie Bauschmann</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>scalar_field_interfaces</depend>
  <!-- C++ GMRF backend (only built with -DSCALAR_FIELD_BELIEF_BUILD_GMRF=ON).
       toml++ has no rosdep key: install libtomlplusplus-dev manually (see gmrf/README.md). -->
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <!-- Belief playground (SCALAR_FIELD_BELIEF_BUILD_PLAYGROUND, default ON): GMRF
       pybind11 module. Its Qt GUI additionally needs PySide6 + pyqtgraph in the
       Python environment that runs it (pip; see tools/belief_playground/README.md). -->
  <build_depend>pybind11-dev</build_depend>
  <build_depend>python3-dev</build_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>hippo_common</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- visGP belief (scalar_field_belief.visgp): dense linear algebra. -->
  <exec_depend>python3-scipy</exec_depend>
  <!-- belief_live_viewer (installed with the playground): odometry poses. -->
  <exec_depend>nav_msgs</exec_depend>
  <!-- Scenarios and simulation nodes for top_field_sim_stack.launch.py and the playground. -->
  <exec_depend>scalar_field_sim</exec_depend>
  
  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
